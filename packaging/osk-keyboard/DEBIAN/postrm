#!/bin/sh
# Post-remove: refresh the desktop cache.
#
# Deliberately does NOT touch ~/.config/erhai-osk (keyboard position and on/off
# state): that is user data and reinstalling should keep it.  Neither does it
# edit any user's enabled-extensions list -- the shell simply ignores a uuid
# whose directory is gone.
set -e

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi

exit 0
